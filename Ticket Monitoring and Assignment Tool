    .detail-label { color: #8a95a6; text-transform: uppercase; letter-spacing: .08em; font-size: 9px; font-weight: 750; margin: 16px 0 6px; }
    .detail-value { color: #4c596e; font-size: 12px; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
    .detail-footer { display: flex; align-items: center; justify-content: space-between; gap: 14px; border-top: 1px solid var(--line); padding: 16px 23px 20px; }
    .detail-actions { display: flex; gap: 9px; align-items: center; }
    .resolution-box { padding: 15px 17px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface-alt); }
    .assignment-box { padding: 15px 17px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface-alt); margin-top: 22px; }
    .assignment-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
    .assignment-grid .field input, .assignment-grid .field select { width: 100%; border: 1px solid var(--control-border); border-radius: 8px; padding: 10px 11px; font-size: 12px; color: var(--ink); background: var(--control-bg); }
    .assignment-actions { display: flex; align-items: center; justify-content: flex-end; gap: 12px; margin-top: 14px; }
    .assignment-summary { margin-top: 5px; color: var(--muted); font-size: 10px; }
    .resolution-box .field textarea { min-height: 88px; }
    .resolution-note { padding: 13px 15px; border-left: 3px solid var(--green); border-radius: 0 8px 8px 0; background: var(--green-soft); }
    .resolution-note .detail-label { margin-top: 0; }
    .resolution-note .detail-value { color: var(--ink); }
    :root[data-theme="dark"] .success { background: #203b34; border-color: #35614f; color: #9be0bb; }
    :root[data-theme="dark"] .button-primary:hover { background: #7892ff; }
    :root[data-theme="dark"] .field input::placeholder, :root[data-theme="dark"] .field textarea::placeholder { color: #8996ac; }
    :root[data-theme="dark"] .pill.priority-low { color: #c0cadb; background: #303a4a; }
    .footnote { color: #9aa4b4; text-align: center; font-size: 10px; margin-top: 18px; }
    @media (max-width: 760px) {
      main { width: calc(100% - 28px); padding-top: 28px; }
