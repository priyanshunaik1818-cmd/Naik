  <script>
    (() => {
      "use strict";
      const STORAGE_KEY = "naik-support-tickets-v1";
      const LEGACY_STORAGE_KEY = "relay-support-tickets-v1";
      const THEME_KEY = "naik-support-theme-v1";
      const AUTH_KEY = "naik-prototype-user-v1";
      const pageParams = new URLSearchParams(window.location.search);
      const requestedTicketId = pageParams.get("ticket");
      const ticketId = requestedTicketId ? requestedTicketId.replace(/^RLY-(\d+)$/, "SR-$1") : null;
      const createdTicketId = pageParams.get("created");
      const requestedStatus = pageParams.get("status");
      const requestedPriority = pageParams.get("priority");
      const unassignedOnly = pageParams.get("view") === "unassigned";
      const showStatusFilter = !ticketId && !unassignedOnly &&
        (!requestedStatus || requestedStatus === "all");
      const validStatuses = ["all", "Open", "In Progress", "On Hold", "Resolved"];
      const isPriorityView = ["High", "Medium", "Low"].includes(requestedPriority);
      const isTicketListView = !ticketId && (
        unassignedOnly || validStatuses.includes(requestedStatus) || isPriorityView
      );
      const $ = (id) => document.getElementById(id);
      const trackerTab = $("tracker-tab");
      const requestTab = $("request-tab");
      let toastTimer;
      let tickets = loadTickets();
      let currentTheme = readTheme();
      let signedInUser = readSignedInUser();

        function loadTickets() {
        try {
          const current = localStorage.getItem(STORAGE_KEY);
          const legacy = current === null ? localStorage.getItem(LEGACY_STORAGE_KEY) : null;
          if (current === null && legacy === null) return [];
          const parsed = JSON.parse(current === null ? legacy : current);
          if (!Array.isArray(parsed) || !parsed.every((ticket) =>
            ticket && typeof ticket.id === "string" && typeof ticket.name === "string" &&
            typeof ticket.subject === "string" && typeof ticket.status === "string"
          )) throw new Error("Saved ticket data has an invalid format.");
          const migrated = parsed.map((ticket) => ({
            ...ticket,
            id: ticket.id.replace(/^RLY-(\d+)$/, "SR-$1")
          }));
          if (current === null || migrated.some((ticket, index) => ticket.id !== parsed[index].id)) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(migrated));
          }
          return migrated;
        } catch (error) {
          console.error("Could not load support tickets.", error);
          showToast("Saved tickets could not be loaded. Check browser storage.");
          return [];
        }
      }
      function saveTickets() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(tickets));
          return true;
        } catch (error) {
          console.error("Could not save support tickets.", error);
          showToast("Could not save changes. Check browser storage settings.");
          return false;
        }
      }
      function readTheme() {
        try {
          return localStorage.getItem(THEME_KEY) === "dark" ? "dark" : "light";
        } catch (error) {
          console.error("Could not load theme preference.", error);
        }
        return "light";
      }
      function readSignedInUser() {
        try {
          return localStorage.getItem(AUTH_KEY) || "";
        } catch (error) {
          console.error("Could not load sign-in state.", error);
          return "";
        }
      }
      function applySignedInUser(name) {
        signedInUser = typeof name === "string" ? name.trim().slice(0, 80) : "";
        const signedIn = signedInUser.length > 0;
        $("login-view").hidden = signedIn;
        $("user-menu").hidden = !signedIn;
        $("user-name-label").textContent = signedInUser;
        $("user-avatar").textContent = signedIn ? initials(signedInUser) : "?";
      }
      function saveSignedInUser(name) {
        try {
          localStorage.setItem(AUTH_KEY, name);
          applySignedInUser(name);
          return true;
        } catch (error) {
          console.error("Could not save sign-in state.", error);
          $("login-feedback").textContent = "Sign-in could not be saved. Check browser storage settings.";
          return false;
        }
      }
      function logOut() {
        try {
          localStorage.removeItem(AUTH_KEY);
          applySignedInUser("");
          $("user-menu").open = false;
          $("login-name").value = "";
          $("login-name").focus();
        } catch (error) {
          console.error("Could not end the current sign-in.", error);
          showToast("Could not log out. Check browser storage settings.");
        }
      }
      function applyTheme(theme) {
        currentTheme = theme === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = currentTheme;
        document.querySelector('meta[name="theme-color"]').content = currentTheme === "dark" ? "#141b27" : "#f5f7fb";
        document.querySelectorAll('input[name="theme"]').forEach((input) => {
          input.checked = input.value === currentTheme;
        });
      }
      function saveTheme(theme) {
        applyTheme(theme);
        try {
          localStorage.setItem(THEME_KEY, currentTheme);
          return true;
        } catch (error) {
          console.error("Could not save theme preference.", error);
          showToast("Theme changed, but could not be saved in this browser.");
          return false;
        }
      }
      function initials(name) {
        return name.trim().split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase() || "?";
      }
      function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, (character) => ({
          "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
        })[character]);
      }
      function formatDate(value) {
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return "—";
        return new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric" }).format(date);
      }
      function priorityClass(priority) {
        const normalized = String(priority).toLowerCase();
        return `priority-${["low", "medium", "high"].includes(normalized) ? normalized : "low"}`;
      }
      function statusClass(status) {
        if (status === "In Progress") return "status-progress";
        if (status === "On Hold") return "status-hold";
        if (status === "Resolved") return "status-resolved";
        return "status-open";
      }
      function render() {
        const query = $("search").value.trim().toLowerCase();
        const priority = $("filter-priority").value;
        const status = showStatusFilter ? $("filter-status").value
          : validStatuses.includes(requestedStatus) ? requestedStatus : "all";
        const createdDate = $("filter-created").value;
        const currentAssignee = $("filter-assignee").value;
        const assignees = [...new Set(tickets.map((ticket) => ticket.assignee).filter(Boolean))].sort((a, b) => a.localeCompare(b));
        $("filter-assignee").innerHTML = '<option value="">Select assignee</option>' +
          assignees.map((name) => `<option value="${escapeHtml(name)}">${escapeHtml(name)}</option>`).join("");
        $("filter-assignee").value = assignees.includes(currentAssignee) ? currentAssignee : "";
        const assignee = $("filter-assignee").value;
        const filtered = tickets.filter((ticket) => {
          const matchesStatus = status === "all" || (status === "__unassigned__" ? !ticket.assignee : ticket.status === status);
          const matchesPriority = priority === "all" || ticket.priority === priority;
          const matchesAssignee = !assignee || ticket.assignee === assignee;
          const matchesAssignment = !unassignedOnly || !ticket.assignee;
          const ticketDate = new Date(ticket.createdAt);
          const ticketCreatedDate = Number.isNaN(ticketDate.getTime()) ? "" : `${ticketDate.getFullYear()}-${String(ticketDate.getMonth() + 1).padStart(2, "0")}-${String(ticketDate.getDate()).padStart(2, "0")}`;
          const matchesCreatedDate = !createdDate || ticketCreatedDate === createdDate;
          const searchable = [ticket.id, ticket.name, ticket.email, ticket.subject, ticket.category, ticket.assignee].join(" ").toLowerCase();
          return matchesStatus && matchesPriority && matchesAssignee && matchesCreatedDate && matchesAssignment && searchable.includes(query);
        });
        $("stat-total").textContent = tickets.length;
        $("stat-open").textContent = tickets.filter((ticket) => ticket.status === "Open").length;
        $("stat-progress").textContent = tickets.filter((ticket) => ticket.status === "In Progress").length;
        $("stat-hold").textContent = tickets.filter((ticket) => ticket.status === "On Hold").length;
        $("stat-unassigned").textContent = tickets.filter((ticket) => !ticket.assignee).length;
        $("stat-high-priority").textContent = tickets.filter((ticket) => ticket.priority === "High").length;
        $("stat-medium-priority").textContent = tickets.filter((ticket) => ticket.priority === "Medium").length;
        $("stat-low-priority").textContent = tickets.filter((ticket) => ticket.priority === "Low").length;
        $("ticket-count").textContent = `(${filtered.length})`;
        $("empty-state").hidden = filtered.length !== 0;
        const hasTickets = tickets.length !== 0;
        $("empty-title").textContent = hasTickets ? "No tickets match these filters" : "No tickets yet";
        $("empty-message").textContent = hasTickets ? "Try a different status or search, or clear your filters." : "New client requests will show up here.";
        $("clear-filters").hidden = !hasTickets;
        document.querySelector(".table-scroll table").hidden = filtered.length === 0;
        $("ticket-rows").innerHTML = filtered.map((ticket) => {
          const priorityStyle = priorityClass(ticket.priority);
          const assignee = ticket.assignee
            ? `<div class="assignee"><span class="avatar">${escapeHtml(initials(ticket.assignee))}</span>${escapeHtml(ticket.assignee)}</div>${ticket.assignmentGroup ? `<div class="assignment-summary">${escapeHtml(ticket.assignmentGroup)}</div>` : ""}`
            : '<span class="unassigned">Unassigned</span>';
          const assignment = ticket.assignmentGroup && !ticket.assignee
            ? `<div class="assignment-summary">${escapeHtml(ticket.assignmentGroup)}</div>`
            : "";
          const action = ticket.assignee
            ? '<button class="assign-btn" disabled>Assigned</button>'
            : `<button class="assign-btn" type="button" data-assign="${escapeHtml(ticket.id)}">Assign to me</button>`;
          return `<tr data-ticket-id="${escapeHtml(ticket.id)}">
            <td><a class="ticket-id" style="text-decoration:none" href="?ticket=${encodeURIComponent(ticket.id)}" target="_blank" rel="opener">${escapeHtml(ticket.id)}</a><a class="subject subject-link" style="margin-top:5px;text-decoration:none" href="?ticket=${encodeURIComponent(ticket.id)}" target="_blank" rel="opener">${escapeHtml(ticket.subject)}</a><div class="customer">${escapeHtml(ticket.name)} · ${escapeHtml(ticket.category)}</div></td>
            <td><span class="pill ${priorityStyle}">${escapeHtml(ticket.priority)}</span></td>
            <td><span class="pill ${statusClass(ticket.status)}">${escapeHtml(ticket.status)}</span></td>
            <td>${assignee}${assignment}</td><td class="date">${escapeHtml(formatDate(ticket.createdAt))}</td><td class="row-actions">${action}</td>
          </tr>`;
        }).join("");
      }
      function showToast(message) {
        const toast = $("toast");
        toast.textContent = message;
        toast.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove("show"), 2800);
      }
      function setPage(page) {
        const isRequest = page === "request";
        $("tracker-view").hidden = isRequest;
        $("request-view").hidden = !isRequest;
        trackerTab.hidden = !isRequest && !isTicketListView;
        trackerTab.classList.toggle("active", !isRequest);
        requestTab.classList.toggle("active", isRequest);
        $("page-title").hidden = isRequest;
        if (isRequest) $("success-message").style.display = "none";
        else render();
      }
      if (isTicketListView) {
        trackerTab.textContent = "← Back to Dashboard";
        trackerTab.setAttribute("aria-label", "Back to Dashboard");
        trackerTab.hidden = false;
      }
      trackerTab.addEventListener("click", () => {
        if (isTicketListView) window.location.replace("./index.html");
        else setPage("tracker");
      });
      requestTab.addEventListener("click", () => setPage("request"));
      $("search").addEventListener("input", render);
      ["filter-priority", "filter-status", "filter-assignee", "filter-created"].forEach((id) => {
        $(id).addEventListener("change", render);
      });
      const clearFilters = () => {
        $("search").value = "";
        $("filter-priority").value = "all";
        $("filter-status").value = "all";
        $("filter-assignee").value = "";
        $("filter-created").value = "";
        render();
      };
      $("filter-clear").addEventListener("click", clearFilters);
      $("clear-filters").addEventListener("click", clearFilters);
      $("preferences-dialog").addEventListener("change", (event) => {
        if (event.target.matches('input[name="theme"]')) saveTheme(event.target.value);
      });
      $("open-preferences").addEventListener("click", () => {
        $("user-menu").open = false;
        $("preferences-dialog").showModal();
      });
      $("open-helpline").addEventListener("click", () => {
        $("user-menu").open = false;
        $("helpline-dialog").showModal();
      });
      $("logout").addEventListener("click", logOut);
      $("login-form").addEventListener("submit", (event) => {
        event.preventDefault();
        if (!$("login-form").reportValidity()) return;
        const name = $("login-name").value.trim().slice(0, 80);
        if (!name) return;
        $("login-feedback").textContent = "";
        saveSignedInUser(name);
      });
      document.querySelectorAll(".modal-close").forEach((button) => {
        button.addEventListener("click", () => button.closest("dialog").close());
      });
      function renderTicketDetails(ticketId) {
        const ticket = tickets.find((item) => item.id === ticketId);
        $("detail-feedback").textContent = "";
        if (!ticket) {
          $("detail-id").textContent = ticketId || "Ticket";
          $("detail-subject").textContent = "Ticket not found";
          $("detail-badges").replaceChildren();
          $("detail-client").textContent = "This ticket may have been removed or is not available in this browser.";
          $("detail-description").textContent = "";
          $("detail-assignee").textContent = "";
          $("assignment-box").hidden = true;
          $("resolution-form-box").hidden = true;
          $("resolution-note-box").style.display = "none";
          $("resolve-ticket").hidden = true;
          return;
        }
        $("detail-id").textContent = ticket.id;
        $("detail-subject").textContent = ticket.subject;
        $("detail-badges").innerHTML = `<span class="pill ${statusClass(ticket.status)}">${escapeHtml(ticket.status)}</span><span class="pill ${priorityClass(ticket.priority)}">${escapeHtml(ticket.priority)} priority</span>`;
        $("detail-client").textContent = `${ticket.name} · ${ticket.email} · Submitted ${formatDate(ticket.createdAt)}`;
        $("detail-description").textContent = ticket.description || "No description provided.";
        $("detail-assignee").textContent = ticket.assignee || "Unassigned";
        $("assignment-box").hidden = false;
        $("assign-to").value = ticket.assignee || "";
        const knownGroups = ["", "Customer Support", "Technical Support", "Billing", "Account Access", "Other team"];
        $("assignment-group").value = knownGroups.includes(ticket.assignmentGroup || "") ? (ticket.assignmentGroup || "") : "Other team";
        $("other-team-field").hidden = $("assignment-group").value !== "Other team";
        $("other-team-name").value = $("assignment-group").value === "Other team" && ticket.assignmentGroup !== "Other team"
          ? ticket.assignmentGroup || ""
          : "";
        $("assignment-summary").textContent = ticket.assignmentGroup
          ? `Assigned to ${ticket.assignmentGroup}${ticket.assignee ? ` · ${ticket.assignee}` : ""}`
          : "No assignment group selected.";
        const isResolved = ticket.status === "Resolved";
        $("resolution-form-box").hidden = isResolved;
        $("resolution-note-box").style.display = isResolved ? "block" : "none";
        if (isResolved) {
          $("resolution-comment").value = "";
          $("resolution-note").textContent = ticket.resolutionComment || "No resolution justification was recorded.";
          $("resolution-meta").textContent = ticket.resolutionComment
            ? `Resolved by ${ticket.resolvedBy || "Support team"}${ticket.resolvedAt ? ` · ${formatDate(ticket.resolvedAt)}` : ""}`
            : "";
        }
        $("resolve-ticket").hidden = false;
        $("resolve-ticket").disabled = isResolved;
        $("resolve-ticket").textContent = isResolved ? "Ticket resolved" : "Mark as resolved";
        $("hold-ticket").hidden = isResolved;
        $("hold-ticket").textContent = ticket.status === "On Hold" ? "Resume work" : "Put on hold";
      }
      $("assignment-group").addEventListener("change", () => {
        $("other-team-field").hidden = $("assignment-group").value !== "Other team";
        $("assignment-summary").textContent = "";
      });
      $("save-assignment").addEventListener("click", () => {
        const ticket = tickets.find((item) => item.id === ticketId);
        if (!ticket) return;
        const assignee = $("assign-to").value.trim().slice(0, 80);
        const selectedGroup = $("assignment-group").value;
        const assignmentGroup = selectedGroup === "Other team"
          ? $("other-team-name").value.trim().slice(0, 80)
          : selectedGroup;
        if (selectedGroup === "Other team" && !assignmentGroup) {
          $("other-team-name").setCustomValidity("Enter the name of the team to assign this ticket to.");
          $("other-team-name").reportValidity();
          $("other-team-name").focus();
          $("other-team-name").addEventListener("input", () => $("other-team-name").setCustomValidity(""), { once: true });
          return;
        }
        const previous = {
          assignee: ticket.assignee,
          assignmentGroup: ticket.assignmentGroup,
          status: ticket.status
        };
        ticket.assignee = assignee;
        ticket.assignmentGroup = assignmentGroup;
        if (ticket.status === "Open" && assignee) ticket.status = "In Progress";
        if (!saveTickets()) {
          ticket.assignee = previous.assignee;
          ticket.assignmentGroup = previous.assignmentGroup;
          ticket.status = previous.status;
          return;
        }
        renderTicketDetails(ticket.id);
        $("detail-feedback").textContent = "Ticket assignment saved.";
      });
      $("hold-ticket").addEventListener("click", () => {
        const ticket = tickets.find((item) => item.id === ticketId);
        if (!ticket || ticket.status === "Resolved") return;
        const previousStatus = ticket.status;
        ticket.status = previousStatus === "On Hold"
          ? (ticket.assignee ? "In Progress" : "Open")
          : "On Hold";
        if (!saveTickets()) {
          ticket.status = previousStatus;
          return;
        }
        renderTicketDetails(ticket.id);
        $("detail-feedback").textContent = ticket.status === "On Hold"
          ? "Ticket put on hold for further checking."
          : "Ticket returned to the active queue.";
      });
      $("resolve-ticket").addEventListener("click", () => {
        const ticket = tickets.find((item) => item.id === ticketId);
        if (!ticket || ticket.status === "Resolved") return;
        const resolutionComment = $("resolution-comment").value.trim();
        if (!resolutionComment) {
          $("resolution-comment").setCustomValidity("Enter a resolution justification before resolving this ticket.");
          $("resolution-comment").reportValidity();
          $("resolution-comment").focus();
          $("resolution-comment").addEventListener("input", () => $("resolution-comment").setCustomValidity(""), { once: true });
          return;
        }
        const previous = {
          status: ticket.status,
          resolutionComment: ticket.resolutionComment,
          resolvedBy: ticket.resolvedBy,
          resolvedAt: ticket.resolvedAt
        };
        ticket.status = "Resolved";
        ticket.resolutionComment = resolutionComment;
        ticket.resolvedBy = signedInUser || ticket.assignee || "Support team";
        ticket.resolvedAt = new Date().toISOString();
        if (!saveTickets()) {
          ticket.status = previous.status;
          ticket.resolutionComment = previous.resolutionComment;
          ticket.resolvedBy = previous.resolvedBy;
          ticket.resolvedAt = previous.resolvedAt;
          return;
        }
        renderTicketDetails(ticket.id);
        $("detail-feedback").textContent = "Ticket marked as resolved.";
      });
      $("ticket-rows").addEventListener("click", (event) => {
        const button = event.target.closest("[data-assign]");
        if (!button) return;
        const name = signedInUser;
        if (!name) {
          showToast("Sign in before assigning this ticket.");
          return;
        }
        const ticket = tickets.find((item) => item.id === button.dataset.assign);
        if (!ticket || ticket.assignee) {
          showToast("This ticket has already been assigned.");
          render();
          return;
        }
        ticket.assignee = name;
        ticket.status = "In Progress";
        if (saveTickets()) {
          render();
          showToast(`${ticket.id} assigned to ${name}.`);
        }
      });
      $("detail-back").addEventListener("click", (event) => {
        if (!window.opener || window.opener.closed) return;
        event.preventDefault();
        window.opener.focus();
        window.close();
      });
      $("request-form").addEventListener("submit", (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        if (!form.reportValidity()) return;
        const values = new FormData(form);
        const newest = tickets.reduce((max, ticket) => {
          const match = /^(?:SR|RLY)-(\d+)$/.exec(ticket.id);
          return match ? Math.max(max, Number(match[1])) : max;
        }, 1000);
        const ticket = {
          id: `SR-${newest + 1}`,
          name: String(values.get("name")).trim(),
          email: String(values.get("email")).trim(),
          subject: String(values.get("subject")).trim(),
          category: String(values.get("category")),
          description: String(values.get("description")).trim(),
          priority: String(values.get("priority")),
          status: "Open",
          assignee: "",
          createdAt: new Date().toISOString()
        };
        tickets.unshift(ticket);
        if (!saveTickets()) {
          tickets.shift();
          return;
        }
        form.reset();
        const success = $("success-message");
        success.innerHTML = `Your request has been submitted. Your ticket number is <strong>${escapeHtml(ticket.id)}</strong>. Our team will be in touch at ${escapeHtml(ticket.email)}.`;
        success.style.display = "block";
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
      window.addEventListener("storage", (event) => {
        if (event.key === STORAGE_KEY) {
          tickets = loadTickets();
          render();
          if (ticketId) renderTicketDetails(ticketId);
        }
        if (event.key === THEME_KEY) applyTheme(event.newValue);
        if (event.key === AUTH_KEY) applySignedInUser(event.newValue || "");
      });
      applyTheme(currentTheme);
      applySignedInUser(signedInUser);
      $("summary-cards").hidden = isTicketListView;
      $("status-filter-field").hidden = !showStatusFilter;
      $("assignee-filter-field").hidden = unassignedOnly;
      if (isPriorityView) {
        $("filter-priority").value = requestedPriority;
        $("page-title").textContent = `${requestedPriority} priority tickets`;
      }
      if (requestedStatus && validStatuses.includes(requestedStatus)) {
        const listTitle = unassignedOnly ? "Unassigned tickets"
          : requestedStatus === "all" ? "All tickets"
          : `${requestedStatus} tickets`;
        $("page-title").textContent = listTitle;
      } else if (unassignedOnly) {
        $("page-title").textContent = "Unassigned tickets";
      }
      render();
      if (createdTicketId && !ticketId) {
        $("search").value = createdTicketId;
        render();
        const createdRow = Array.from($("ticket-rows").rows).find((row) =>
          row.dataset.ticketId === createdTicketId
        );
        if (createdRow) {
          showToast(`${createdTicketId} is now on the Dashboard.`);
          createdRow.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          showToast(`${createdTicketId} was submitted but could not be found in saved tickets.`);
        }
      }
      if (ticketId) {
        $("main-heading").hidden = true;
        $("tracker-view").hidden = true;
        $("request-view").hidden = true;
        $("ticket-detail-view").hidden = false;
        renderTicketDetails(ticketId);
        document.title = `${ticketId} — Naik Support`;
      } else if (!requestedStatus && !unassignedOnly && !createdTicketId) {
        window.name = "naik-dashboard";
      }
      if (isTicketListView) {
        document.body.classList.add("filtered-view");
        $("ticket-list-panel").scrollIntoView({ behavior: "smooth", block: "start" });
      }
    })();
  </script>
</body>
</html>


