          <a class="stat stat-link" href="?status=all" target="_blank" rel="opener" aria-label="Open all tickets in a new tab"><div class="stat-label">Total tickets</div><div class="stat-value" id="stat-total">0</div><div class="stat-note">All incoming requests</div></a>
          <a class="stat stat-link" href="?status=Open" target="_blank" rel="opener" aria-label="Open open tickets in a new tab"><div class="stat-label">Open</div><div class="stat-value" id="stat-open">0</div><div class="stat-note">Waiting to be picked up</div></a>
          <a class="stat stat-link" href="?status=In%20Progress" target="_blank" rel="opener" aria-label="Open in-progress tickets in a new tab"><div class="stat-label">In progress</div><div class="stat-value" id="stat-progress">0</div><div class="stat-note">Being worked on</div></a>
          <a class="stat stat-link" href="?status=On%20Hold" target="_blank" rel="opener" aria-label="Open on-hold tickets in a new tab"><div class="stat-label">On hold</div><div class="stat-value" id="stat-hold">0</div><div class="stat-note">Awaiting further checking</div></a>
