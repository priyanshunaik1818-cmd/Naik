    .row-actions { white-space: nowrap; }
    .assign-btn, .button-primary, .button-secondary { border-radius: 7px; font-size: 11px; font-weight: 700; padding: 8px 11px; }
    .button-secondary { border: 1px solid var(--button-border); color: var(--blue); background: var(--control-bg); }
    .button-secondary:hover { background: var(--blue-soft); }
    .assign-btn { border: 1px solid var(--button-border); color: var(--blue); background: var(--control-bg); }
    .assign-btn:hover { background: var(--blue-soft); }
    .assign-btn:disabled { color: var(--muted); border-color: var(--line); cursor: default; background: var(--disabled-bg); }
    .empty { padding: 48px 20px; text-align: center; color: var(--muted); font-size: 13px; }
    .empty-icon { margin: 0 auto 12px; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 13px; color: var(--blue); background: var(--blue-soft); font-size: 19px; }
    .form-card { width: min(680px, 100%); margin: 0 auto; padding: clamp(22px, 5vw, 38px); }
    .form-intro { margin-bottom: 25px; }
    .form-intro h2 { margin: 0; font-size: 21px; letter-spacing: -.04em; }
    .form-intro p { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 17px 15px; }
    .field { display: flex; flex-direction: column; gap: 7px; }
    .field.full { grid-column: 1 / -1; }
    label { font-weight: 650; font-size: 11px; color: var(--muted-strong); }
    .required { color: var(--red); }
    .field input, .field select, .field textarea { width: 100%; border: 1px solid var(--control-border); border-radius: 8px; padding: 10px 11px; font-size: 12px; color: var(--ink); background: var(--control-bg); }
    .field textarea { resize: vertical; min-height: 115px; line-height: 1.5; }
    .field input::placeholder, .field textarea::placeholder { color: #a5adba; }
    .form-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 21px; }
    .form-note { color: #929cad; font-size: 10px; }
    .button-primary { border: 0; color: white; background: var(--blue); padding: 11px 17px; font-size: 12px; box-shadow: 0 3px 8px #4263eb30; }
    .button-primary:hover { background: #3454d1; }
    .success { display: none; border: 1px solid #c8ead7; color: #216c4b; background: #effaf4; padding: 13px 14px; border-radius: 9px; margin-bottom: 18px; font-size: 12px; line-height: 1.5; }
    .toast { position: fixed; z-index: 5; right: 22px; bottom: 22px; background: #172338; color: white; padding: 12px 16px; border-radius: 9px; box-shadow: 0 8px 28px #12203a33; font-size: 12px; opacity: 0; transform: translateY(8px); transition: .2s ease; pointer-events: none; }
    .toast.show { opacity: 1; transform: translateY(0); }
    .detail-head { padding: 21px 23px 16px; border-bottom: 1px solid var(--line); display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
    .detail-head h2 { margin: 5px 0 0; font-size: 19px; letter-spacing: -.04em; }
    .detail-body { padding: 19px 23px 23px; }
    .ticket-detail-panel { max-width: 760px; margin: 0 auto; }
    .detail-back { display: inline-block; padding: 18px 23px 0; color: var(--blue); text-decoration: none; font-size: 12px; font-weight: 700; }
    .detail-back:hover { text-decoration: underline; }
