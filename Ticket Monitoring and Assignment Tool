<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f7fb">
  <title>Raise a request — Naik</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #172338;
      --muted: #778399;
      --line: #e7ebf2;
      --paper: #fff;
      --canvas: #f5f7fb;
      --blue: #4263eb;
      --blue-soft: #eef2ff;
      --red: #c2414b;
      --green: #18865b;
      --green-soft: #eaf7f0;
      --control-border: #dfe4ec;
      --control-bg: #fff;
      --muted-strong: #59667a;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-synthesis: none;
      text-rendering: optimizeLegibility;
    }
    * { box-sizing: border-box; }
    body { min-width: 320px; margin: 0; color: var(--ink); background: var(--canvas); }
    button, input, select, textarea { font: inherit; }
    .topbar { height: 70px; display: flex; align-items: center; justify-content: space-between; padding: 0 clamp(18px, 4vw, 54px); background: var(--paper); border-bottom: 1px solid var(--line); }
    .brand { display: flex; align-items: center; gap: 11px; font-size: 19px; font-weight: 750; letter-spacing: -.04em; }
    .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 11px; background: #172338; color: white; font-size: 15px; }
    .dashboard-link { color: var(--blue); font-size: 12px; font-weight: 700; text-decoration: none; }
    .dashboard-link:hover { text-decoration: underline; }
    main { width: min(760px, calc(100% - 32px)); margin: 0 auto; padding: 42px 0 60px; }
    .eyebrow { margin-bottom: 9px; color: var(--blue); font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    h1 { margin: 0; font-size: clamp(26px, 4vw, 34px); letter-spacing: -.05em; }
    .subtitle { margin: 9px 0 24px; color: var(--muted); font-size: 13px; line-height: 1.55; }
    .panel { padding: clamp(22px, 5vw, 36px); border: 1px solid var(--line); border-radius: 14px; background: var(--paper); }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 17px 15px; }
    .field { display: flex; flex-direction: column; gap: 7px; }
    .field.full { grid-column: 1 / -1; }
    label { color: var(--muted-strong); font-size: 11px; font-weight: 650; }
    .required { color: var(--red); }
    .field input, .field select, .field textarea { width: 100%; border: 1px solid var(--control-border); border-radius: 8px; padding: 10px 11px; color: var(--ink); background: var(--control-bg); font-size: 12px; }
    .field textarea { min-height: 125px; resize: vertical; line-height: 1.5; }
    .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: #879df4; box-shadow: 0 0 0 3px #4263eb18; }
    .field input::placeholder, .field textarea::placeholder { color: #a5adba; }
    .form-footer { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 21px; }
    .form-note { color: #929cad; font-size: 10px; }
    .submit { border: 0; border-radius: 7px; padding: 11px 17px; color: white; background: var(--blue); font-size: 12px; font-weight: 700; cursor: pointer; box-shadow: 0 3px 8px #4263eb30; }
    .submit:hover { background: #3454d1; }
    .error { display: none; margin-bottom: 17px; padding: 12px 14px; border: 1px solid #f0c4c4; border-radius: 8px; color: var(--red); background: #fff5f5; font-size: 12px; line-height: 1.5; }
    .success { display: none; padding: 12px 14px; border: 1px solid #c8ead7; border-radius: 8px; color: var(--green); background: var(--green-soft); font-size: 12px; line-height: 1.5; }
