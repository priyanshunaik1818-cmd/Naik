      .form-grid { grid-template-columns: 1fr; }
      .field.full { grid-column: auto; }
      .form-footer { align-items: flex-start; flex-direction: column; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand"><span class="brand-mark">N</span> Naik</div>
    <a class="dashboard-link" href="./index.html">Support desk</a>
  </header>
  <main>
    <div class="eyebrow">Customer support</div>
    <h1>Raise a Request</h1>
    <p class="subtitle">Complete the form and our support team will review your request.</p>
    <section class="panel">
      <div class="error" id="form-error" role="alert"></div>
      <div class="success" id="form-success" role="status"></div>
      <form id="client-request-form">
        <div class="form-grid">
          <div class="field"><label for="client-name">Your name <span class="required">*</span></label><input id="client-name" name="name" required maxlength="80" autocomplete="name" placeholder="e.g. Alex Morgan"></div>
          <div class="field"><label for="client-email">Email address <span class="required">*</span></label><input id="client-email" name="email" type="email" required maxlength="160" autocomplete="email" placeholder="you@company.com"></div>
          <div class="field full"><label for="subject">What can we help with? <span class="required">*</span></label><input id="subject" name="subject" required maxlength="120" placeholder="A short summary of your issue"></div>
          <div class="field"><label for="category">Request type</label><select id="category" name="category"><option>General question</option><option>Technical issue</option><option>Billing</option><option>Account access</option><option>Feature request</option><option>Other</option></select></div>
          <div class="field"><label for="priority">How urgent is it?</label><select id="priority" name="priority"><option>Low</option><option selected>Medium</option><option>High</option></select></div>
          <div class="field full"><label for="description">Details <span class="required">*</span></label><textarea id="description" name="description" required maxlength="3000" placeholder="Share any details that will help us understand your request..."></textarea></div>
        </div>
        <div class="form-footer"><span class="form-note">Fields marked * are required.</span><button class="submit" type="submit">Submit request&nbsp; →</button></div>
      </form>
    </section>
  </main>
  <script>
    (() => {
      "use strict";
      const STORAGE_KEY = "naik-support-tickets-v1";
      const LEGACY_STORAGE_KEY = "relay-support-tickets-v1";
      const form = document.getElementById("client-request-form");
      const errorBox = document.getElementById("form-error");

      function loadTickets() {
        const stored = localStorage.getItem(STORAGE_KEY) ?? localStorage.getItem(LEGACY_STORAGE_KEY);
        if (stored === null) return [];
        const tickets = JSON.parse(stored);
        if (!Array.isArray(tickets) || !tickets.every((ticket) =>
          ticket && typeof ticket.id === "string" && typeof ticket.subject === "string"
        )) throw new Error("Saved ticket data has an invalid format.");
        return tickets.map((ticket) => ({
          ...ticket,
          id: ticket.id.replace(/^RLY-(\d+)$/, "SR-$1")
        }));
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        errorBox.style.display = "none";
        if (!form.reportValidity()) return;
        try {
          const tickets = loadTickets();
          const newest = tickets.reduce((max, ticket) => {
            const match = /^(?:SR|RLY)-(\d+)$/.exec(ticket.id);
            return match ? Math.max(max, Number(match[1])) : max;
          }, 1000);
          const values = new FormData(form);
          const ticket = {
            id: `SR-${newest + 1}`,
            name: String(values.get("name")).trim(),
            email: String(values.get("email")).trim(),
            subject: String(values.get("subject")).trim(),
            category: String(values.get("category")),
            description: String(values.get("description")).trim(),
            priority: String(values.get("priority")),
            status: "Open",
            assignee: "",
            assignmentGroup: "",
            createdAt: new Date().toISOString()
          };
          tickets.unshift(ticket);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(tickets));
          document.getElementById("form-success").textContent = `Request submitted. Ticket ${ticket.id} is being redirected to the support dashboard.`;
          document.getElementById("form-success").style.display = "block";
          form.querySelector("button[type=submit]").disabled = true;
          window.setTimeout(() => {
            window.location.assign(`./index.html?created=${encodeURIComponent(ticket.id)}`);
          }, 700);
        } catch (error) {
          console.error("Could not submit the client request.", error);
          errorBox.textContent = "Your request could not be saved. Please check browser storage settings and try again.";
          errorBox.style.display = "block";
        }
      });
    })();
  </script>
</body>
</html>

